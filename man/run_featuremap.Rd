\name{run_featuremap}
\alias{run_featuremap}
\title{Launch the FeatureMAP Shiny Application}
\usage{
run_featuremap(...)
}
\arguments{
  \item{...}{Additional arguments passed to \code{shiny::runApp()}.}
}
\value{
The return value from \code{shiny::runApp()}.
}
\description{
Starts the packaged FeatureMAP Shiny application installed under
\code{inst/app}.
}
